PORT=8080
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-different-long-random-secret
AUTH_TOKEN_TTL_HOURS=168
ADMIN_EMAIL=ChatSphere@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
MYSQL_DSN=chatsphere:password@tcp(localhost:3306)/chatsphere?parseTime=true
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/chatsphere
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
BREVO_API_KEY=replace-me
BREVO_SENDER_EMAIL=hello@yourdomain.com
BREVO_SENDER_NAME=ChatSphere
DATA_PATH=data/chatsphere.json

# Gemini AI assistant
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_DAILY_LIMIT=20
GEMINI_IP_RATE_LIMIT=5
GEMINI_REQUEST_COOLDOWN_SECONDS=2
GEMINI_MAX_MESSAGE_LENGTH=2000
GEMINI_MAX_OUTPUT_TOKENS=500
GEMINI_TIMEOUT_SECONDS=30
